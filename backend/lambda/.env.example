# Examples only. Do not commit real deployment values.
AWS_REGION=eu-north-1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spill_demo
DB_USER=app_user
DB_PASS=replace-locally
IOT_ENDPOINT=example-ats.iot.eu-north-1.amazonaws.com
SENDER=sender@example.com
RECIPIENTS=operations@example.com
ALERT_TABLE=sensor_alert_state
TABLE_NAME=ActuatorState
ENABLE_IOT_PUBLISH=false
HEARTBEAT_TIMEOUT_SECONDS=60
# Optional legacy handlers, excluded from root deployment:
ALERT_FUNCTION_NAME=AlertNotificationServiceauto
SES_FROM_EMAIL=sender@example.com
SES_TO_EMAILS=operations@example.com

# Analytics only: explicit current sensor-zone mapping, not historical locations.
SENSOR_ZONE_MAP={"0":1,"1":1,"2":2,"3":3,"4":3,"5":2}
