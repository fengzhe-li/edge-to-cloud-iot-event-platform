{
  "RoleName": "AlertNotificationServiceauto-role-j961wplw",
  "PolicyName": "Auto312",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "DynamoAccess",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem"
        ],
        "Resource": "arn:aws:SERVICE:REGION:123456789012:RESOURCE_PLACEHOLDER"
      },
      {
        "Sid": "SesAccess",
        "Effect": "Allow",
        "Action": [
          "ses:SendEmail",
          "ses:SendRawEmail"
        ],
        "Resource": "*"
      }
    ]
  }
}
