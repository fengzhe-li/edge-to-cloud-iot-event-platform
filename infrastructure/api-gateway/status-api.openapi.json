{
  "openapi": "3.0.1",
  "info": {
    "title": "Sensor Status API",
    "version": "1.0.0",
    "description": "Sanitised portfolio specification with live AWS identifiers replaced by placeholders."
  },
  "servers": [
    {
      "url": "https://YOUR_API_ID.execute-api.eu-north-1.amazonaws.com/{basePath}",
      "variables": {
        "basePath": {
          "default": ""
        }
      }
    }
  ],
  "paths": {
    "/sensor-status": {
      "get": {
        "responses": {
          "default": {
            "description": "Default response for GET /sensor-status"
          }
        },
        "x-amazon-apigateway-integration": {
          "payloadFormatVersion": "2.0",
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:eu-north-1:lambda:path/2015-03-31/functions/arn:aws:lambda:eu-north-1:123456789012:function:StatusApiLambda/invocations",
          "connectionType": "INTERNET"
        }
      }
    }
  },
  "components": {
    "x-amazon-apigateway-integrations": {}
  },
  "x-amazon-apigateway-cors": {
    "allowMethods": [
      "GET",
      "OPTIONS",
      "POST"
    ],
    "allowHeaders": [
      "authorization",
      "content-type",
      "x-amz-date",
      "x-amz-security-token",
      "x-api-key"
    ],
    "maxAge": 0,
    "allowCredentials": false,
    "allowOrigins": [
      "*"
    ]
  },
  "x-amazon-apigateway-importexport-version": "1.0",
  "x-portfolio-security-notes": [
    "Restrict CORS to the deployed frontend origin in production.",
    "Protect operational routes with Cognito or JWT authorization.",
    "Apply least-privilege IAM permissions to Lambda integrations."
  ]
}
